# Install as /etc/systemd/system/kuccps-api.service (see docs/deploy.md). Runs the API with gunicorn on a local port
# that only nginx can reach. The secrets live in /etc/kuccps-api.env, not in this file.
[Unit]
Description=KUCCPS Course Advisor API (gunicorn)
After=network.target

[Service]
User=deploy
Group=deploy
WorkingDirectory=/var/www/kuccps-api
EnvironmentFile=/etc/kuccps-api.env
ExecStart=/var/www/kuccps-api/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8013 --workers 3 --timeout 60
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
